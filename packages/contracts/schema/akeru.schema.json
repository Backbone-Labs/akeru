{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Backbone-Labs/akeru/blob/main/packages/contracts/schema/akeru.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "id",
    "version",
    "sdk",
    "title",
    "entry",
    "artifacts",
    "provenance",
    "input",
    "runtime",
    "capabilities",
    "saves"
  ],
  "properties": {
    "specVersion": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range"
      ],
      "properties": {
        "range": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "entry": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_-]+(?:[./][A-Za-z0-9_-]+)*$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_-]+(?:[./][A-Za-z0-9_-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "assets"
      ],
      "properties": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "revision",
            "license",
            "rightsStatus"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 2048
            },
            "revision": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "rightsStatus": {
              "enum": [
                "unknown",
                "documented"
              ]
            }
          }
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "kind",
              "license",
              "evidence"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9_-]+(?:[./][A-Za-z0-9_-]+)*$"
              },
              "kind": {
                "enum": [
                  "original",
                  "upstream",
                  "generated",
                  "unknown"
                ]
              },
              "license": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://",
                  "maxLength": 2048
                }
              }
            }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller",
        "touch"
      ],
      "properties": {
        "controller": {
          "const": true
        },
        "touch": {
          "const": true
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphics",
        "requiredFeatures",
        "optionalFeatures"
      ],
      "properties": {
        "graphics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preferred",
            "fallback"
          ],
          "properties": {
            "preferred": {
              "enum": [
                "dom",
                "canvas2d",
                "webgl2",
                "webgpu"
              ]
            },
            "fallback": {
              "enum": [
                "webgl2",
                null
              ]
            }
          }
        },
        "requiredFeatures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "wasm",
              "simd",
              "threads",
              "wasm-gc",
              "memory64"
            ]
          }
        },
        "optionalFeatures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "wasm",
              "simd",
              "threads",
              "wasm-gc",
              "memory64"
            ]
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "save.local",
          "save.account-sync"
        ]
      }
    },
    "saves": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "guestLocal",
        "accountSync"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "guestLocal": {
          "const": true
        },
        "accountSync": {
          "enum": [
            "optional",
            "disabled"
          ]
        }
      }
    }
  }
}
