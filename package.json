{
  "name": "akeru",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.21.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test && npm run check:public",
    "check:public": "node scripts/check-public-tree.mjs",
    "package:source": "node scripts/package-source.mjs",
    "package:staging": "node scripts/package-staging.mjs",
    "preview:staging": "node scripts/serve-staging.mjs",
    "package:cloudflare": "node scripts/package-cloudflare.mjs",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,css,html,yml}\"",
    "format": "prettier --write \"**/*.{js,mjs,ts,css,html,yml}\"",
    "typecheck": "tsc -p tsconfig.json",
    "test:browser": "playwright test",
    "package:catalog": "node scripts/package-catalog.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/cli": "4.3.3",
    "eslint": "10.12.0",
    "espree": "11.2.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "parse5": "8.0.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "three": "0.180.0",
    "three-legacy": "npm:three@0.186.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@tailwindcss/cli": {
      "@parcel/watcher": "2.6.0"
    }
  }
}
