{
  "name": "akeru",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": "24.21.0",
    "npm": "11.21.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test && npm run check:public",
    "check:public": "node scripts/check-public-tree.mjs",
    "package:source": "node scripts/package-source.mjs",
    "package:staging": "node scripts/package-staging.mjs",
    "preview:staging": "node scripts/serve-staging.mjs",
    "package:cloudflare": "node scripts/package-cloudflare.mjs",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,css,html,yml}\"",
    "format": "prettier --write \"**/*.{js,mjs,ts,css,html,yml}\"",
    "typecheck": "tsc -p tsconfig.json",
    "test:browser": "playwright test",
    "package:catalog": "node scripts/package-catalog.mjs",
    "build:kart-multiplayer": "node packages/old-san-juan-kart/build.mjs && node packages/old-san-juan-kart/multiplayer/build.mjs && node packages/multiplayer/build.mjs",
    "preview:kart-multiplayer": "npm run build:kart-multiplayer && node examples/catalog-demo/multiplayer.mjs",
    "test:kart-multiplayer": "npm run build:kart-multiplayer && node --test tests/multiplayer*.test.mjs && playwright test tests/browser/kart-multiplayer.spec.mjs tests/browser/old-san-juan-kart.spec.mjs",
    "build:blackline-multiplayer": "node packages/operation-blackline/build.mjs && node packages/operation-blackline/multiplayer/build.mjs && node packages/multiplayer/build.mjs",
    "build:multiplayer": "npm run build:kart-multiplayer && npm run build:blackline-multiplayer",
    "preview:multiplayer": "npm run build:multiplayer && node examples/catalog-demo/multiplayer-all.mjs",
    "test:blackline-multiplayer": "npm run build:multiplayer && node --test tests/blackline-multiplayer*.test.mjs && playwright test tests/browser/blackline-*.spec.mjs"
  },
  "devDependencies": {
    "@colyseus/core": "0.18.17",
    "@colyseus/redis-driver": "0.18.4",
    "@colyseus/redis-presence": "0.18.5",
    "@colyseus/schema": "5.0.34",
    "@colyseus/sdk": "0.18.4",
    "@colyseus/ws-transport": "0.18.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "parse5": "8.0.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "three": "0.180.0",
    "three-blackline": "npm:three@0.186.1",
    "three-legacy": "npm:three@0.128.0",
    "typescript": "7.0.2",
    "@tailwindcss/cli": "4.3.3",
    "espree": "11.2.0",
    "ws": "8.22.0"
  },
  "overrides": {
    "@tailwindcss/cli": {
      "@parcel/watcher": "2.6.0"
    }
  }
}
